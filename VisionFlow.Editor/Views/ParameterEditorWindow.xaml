<Window x:Class="VisionFlow.Editor.Views.ParameterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:VisionFlow.Editor.Views"
        Title="{Binding Title}" Height="800" Width="1200"
        WindowStartupLocation="CenterOwner" Background="#F0F0F0">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ── nút ── -->
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background" Value="#0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="GreenBtn" TargetType="Button">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="SubtleBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── template tham số (tên ở trên, control ở dưới) ── -->
        <DataTemplate x:Key="PlainTextTemplate">
            <StackPanel Margin="0,5">
                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="#222" Margin="0,0,0,2"/>
                <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="FilePathTemplate">
            <StackPanel Margin="0,5">
                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="#222" Margin="0,0,0,2"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource SubtleBtn}" Margin="4,0,0,0" Command="{Binding BrowseCommand}"/>
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
                </DockPanel>
            </StackPanel>
        </DataTemplate>
        <!-- MỚI: template cho tham số chọn THƯ MỤC (khác FilePathTemplate ở chỗ gọi BrowseFolderCommand) -->
        <DataTemplate x:Key="FolderPathTemplate">
            <StackPanel Margin="0,5">
                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="#222" Margin="0,0,0,2"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource SubtleBtn}" Margin="4,0,0,0" Command="{Binding BrowseFolderCommand}"/>
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"/>
                </DockPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SliderTemplate">
            <StackPanel Margin="0,5">
                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="#222"/>
                <!-- Slider + ô nhập số (cùng bind NumericValue → đồng bộ 2 chiều). -->
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}"
                            Value="{Binding NumericValue}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center"
                             Text="{Binding NumericValue, StringFormat=0.######, UpdateSourceTrigger=LostFocus}"/>
                </Grid>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="BoolTemplate">
            <CheckBox Content="{Binding Name}" IsChecked="{Binding Value}" FontSize="11" Margin="0,6"/>
        </DataTemplate>
        <DataTemplate x:Key="EnumTemplate">
            <StackPanel Margin="0,5">
                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="#222" Margin="0,0,0,2"/>
                <ComboBox ItemsSource="{Binding EnumOptions}" SelectedItem="{Binding Value}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ReadOnlyTemplate">
            <StackPanel Margin="0,5">
                <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" Foreground="#222" Margin="0,0,0,2"/>
                <TextBlock Text="◳ set on image" Foreground="#0078D7" FontStyle="Italic" FontSize="10"/>
            </StackPanel>
        </DataTemplate>
        <v:ParameterTemplateSelector x:Key="ParamSelector"
            PlainTextTemplate="{StaticResource PlainTextTemplate}" FilePathTemplate="{StaticResource FilePathTemplate}"
            FolderPathTemplate="{StaticResource FolderPathTemplate}"
            SliderTemplate="{StaticResource SliderTemplate}" BoolTemplate="{StaticResource BoolTemplate}"
            EnumTemplate="{StaticResource EnumTemplate}" ReadOnlyTemplate="{StaticResource ReadOnlyTemplate}"/>

        <!-- tab category -->
        <Style x:Key="CatTabs" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" Padding="8,4" FontSize="11"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ─── TOP BAR ─── -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="▶ Run Node" Style="{StaticResource GreenBtn}" Click="OnRunClicked" Margin="0,0,6,0" MinWidth="84"/>
                    <Button Content="Cancel" Style="{StaticResource SubtleBtn}" Click="OnCancelClicked" Margin="0,0,6,0" MinWidth="60"/>
                    <Button Content="Apply" Style="{StaticResource AccentBtn}" Click="OnCloseClicked" MinWidth="64"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ─── BODY 22/78 ─── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.24*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="0.76*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: parameters -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="10,8,10,6" Background="White">
                        <TextBlock Text="NODE PARAMETERS" FontSize="10" FontWeight="SemiBold" Foreground="#777"/>
                    </Border>
                    <ListBox Grid.Row="1" Style="{StaticResource CatTabs}" ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory}"/>
                    <Border Grid.Row="2" Background="#FAFAFA">
                        <ScrollViewer Padding="10,4" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedCategory.Items}" ItemTemplateSelector="{StaticResource ParamSelector}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#F0F0F0"/>

            <!-- RIGHT: Image Preview + Data Output tabs -->
            <TabControl x:Name="RightTabs" Grid.Column="2" Background="White">
                <TabItem Header="Image Preview" FontSize="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- image toolbar -->
                        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Fit" Style="{StaticResource SubtleBtn}" Click="OnFit" Margin="0,0,8,0"/>
                                <CheckBox x:Name="GridCheck" Content="Grid" IsChecked="{Binding ShowPixelGrid, ElementName=Viewer}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <CheckBox x:Name="RulerCheck" Content="Ruler" IsChecked="{Binding ShowRuler, ElementName=Viewer}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Border Width="1" Height="14" Background="#D0D0D0" Margin="0,0,6,0"/>
                                <TextBlock Text="Zoom" Style="{StaticResource Lbl}" Margin="0,0,4,0"/>
                                <Slider x:Name="ZoomSlider" Width="90" Minimum="0.05" Maximum="20" Value="1"
                                VerticalAlignment="Center" ValueChanged="OnZoomSliderChanged"/>
                                <TextBox x:Name="ZoomText" Text="100%" Width="50" Margin="4,0" IsReadOnly="True" VerticalAlignment="Center"/>
                                <Border Width="1" Height="14" Background="#D0D0D0" Margin="6,0"/>
                                <TextBlock Text="ROI" Style="{StaticResource Lbl}" Margin="0,0,4,0"
                                   Visibility="{Binding HasRoi, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="∠" Style="{StaticResource Lbl}" FontSize="13" Margin="0,0,2,0"
                                   Visibility="{Binding HasRoi, Converter={StaticResource BoolToVis}}"/>
                                <Slider x:Name="AngleSlider" Width="110" Minimum="-180" Maximum="180" VerticalAlignment="Center"
                                ValueChanged="OnAngleChanged"
                                Visibility="{Binding HasRoi, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="(handles: resize • inside: move • outside: draw • ∠: rotate • right-drag: pan • wheel: zoom)" Style="{StaticResource Lbl}" Margin="10,0,0,0"
                                   Visibility="{Binding HasRoi, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock x:Name="StatusInline" Text="{Binding StatusText}" Style="{StaticResource Lbl}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- image -->
                        <v:ImageViewer x:Name="Viewer" Grid.Row="1" Source="{Binding BackgroundImage}"/>

                        <!-- status bar -->
                        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SizeLabel" Text="Size: —" FontSize="10" Foreground="#666" Margin="0,0,20,0"/>
                                <TextBlock x:Name="PosLabel" Text="Position: —" FontSize="10" Foreground="#666" Margin="0,0,20,0"/>
                                <TextBlock x:Name="PixelLabel" Text="Pixel: —" FontSize="10" Foreground="#666"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 2: Data Output (JSON kết quả node) -->
                <TabItem Header="Data Output" FontSize="12">
                    <DockPanel Background="#FAFAFA">
                        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,5">
                            <DockPanel>
                                <TextBlock Text="Node Output Data" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="Copy JSON" Style="{StaticResource SubtleBtn}"
                                    HorizontalAlignment="Right" Click="OnCopyJson"/>
                            </DockPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBox Text="{Binding OutputJson, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="12" Background="#FAFAFA" Padding="8"
                                 TextWrapping="NoWrap" AcceptsReturn="True"/>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>