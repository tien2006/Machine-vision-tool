<Window x:Class="VisionFlow.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VisionFlow.Editor.Views;assembly=VisionFlow.Editor"        xmlns:nnviews="clr-namespace:NodeNetwork.Views;assembly=NodeNetwork"
        xmlns:nodeList="clr-namespace:NodeNetwork.Toolkit.NodeList;assembly=NodeNetworkToolkit"
        Title="VisionFlow — Industrial Vision Flow Editor" Height="760" Width="1280"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <DockPanel>
        <!-- Thanh công cụ -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <TextBlock Text="Flow:" VerticalAlignment="Center" Margin="4,0"/>
                <TextBox Text="{Binding FlowName, UpdateSourceTrigger=PropertyChanged}" Width="160" VerticalAlignment="Center"/>
                <Separator/>
                <Button Command="{Binding RunCommand}" ToolTip="Chạy flow (DAG topo-sort)">▶ Run</Button>
                <Separator/>
                <Separator/>
                <Button Command="{Binding LoadInspectionFlowCommand}" ToolTip="Nạp file flow JSON vào InspectionService (graph riêng)">📥 Load Inspection Flow</Button>
                <Button Command="{Binding RunInspectionCommand}" ToolTip="Chạy 1 lần kiểm tra không qua canvas">🔍 Run Inspection</Button>
                <Button Command="{Binding TestPlcCommand}" ToolTip="Kiểm tra kết nối PLC (giả lập hoặc thật tuỳ appsettings.json)">🔌 PLC Test</Button>
                <Button Command="{Binding StartHandshakeCommand}" ToolTip="Bắt đầu handshake với PLC">▶ Handshake</Button>
                <Button Command="{Binding StopHandshakeCommand}" ToolTip="Dừng handshake (ghi Status = Offline xuống PLC)">■ Stop Handshake</Button>
                <Button Command="{Binding SaveCommand}">💾 Save</Button>
                <Button Command="{Binding LoadCommand}">📂 Load</Button>
                <Separator/>
                <Button Command="{Binding ClearAllCommand}">🗑 Clear</Button>
            </ToolBar>
        </ToolBarTray>
        <!-- Thanh trạng thái -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>
        <TabControl>
            <TabItem Header="Vision Flow">
                <Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="360"/>
                        </Grid.ColumnDefinitions>
                        <!-- Toolbox kéo-thả (NodeNetwork). Kéo một mục ra canvas để tạo node. -->
                        <nodeList:NodeListView Grid.Column="0" ViewModel="{Binding NodeList}" HorizontalAlignment="Stretch"/>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                        <!-- Canvas node (NodeNetwork): kéo từ port output sang port input để nối; double-click để cấu hình. -->
                        <nnviews:NetworkView x:Name="NetworkCanvas" Grid.Column="2" ViewModel="{Binding Network}"/>

                        <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <!-- Bảng phải: tham số / preview / timing -->
                        <Grid Grid.Column="4" Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="5"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding SelectedNode.Tool.DisplayName, StringFormat='Tham số: {0}', FallbackValue='Tham số (chọn 1 node)'}"
                   FontWeight="Bold" Margin="2,2,2,4"/>

                            <!-- Parameter View: editor theo kiểu dữ liệu (dùng selector global, double-click node để cấu hình đầy đủ) -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectedParameters}"
                          ItemTemplateSelector="{StaticResource ParamSelector}"/>
                            </ScrollViewer>
                            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"/>

                            <Border Grid.Row="3" BorderBrush="#DDD" BorderThickness="1" Background="#1E1E1E">
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="2"/>
                            </Border>

                            <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch"/>
                            <DataGrid Grid.Row="5" ItemsSource="{Binding Timings}" AutoGenerateColumns="False"
                  HeadersVisibility="Column" CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Node" Binding="{Binding DisplayName}" Width="*"/>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding State}" Width="Auto"/>
                                    <DataGridTextColumn Header="ms" Binding="{Binding ElapsedMs}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="PC Control">
                <views:PcControlView DataContext="{Binding PcControl}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
                